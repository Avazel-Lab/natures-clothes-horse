<div class="layout">
{% if error %}
  <span class="title">Couldn't get the forecast: {{ error }}</span>
{% else %}
  <div class="nc">
    <div class="nc-row nc-grow" style="align-items: stretch;">
      <div class="nc-row" style="flex: 0 0 36%;">
        <i class="wi {{ now.icon }} nc-wi nc-now-icon"></i>
        <div class="nc-col">
          <span class="value value--large">{{ now.temp }}°</span>
          <span class="label">{{ now.text }}</span>
          <span class="description">Feels {{ now.feels }}° · {{ now.humidity }}% · {{ now.wind }} mph</span>
          <span class="description">Today {{ today.hi }}°/{{ today.lo }}° · Tomorrow {{ tomorrow.hi }}°/{{ tomorrow.lo }}°</span>
        </div>
      </div>
      <div class="nc-wash nc-wash--{{ wash.code }} nc-row">
        <i class="wi {{ wash.icon }} nc-wi" style="font-size: 44px;"></i>
        <div class="nc-col nc-grow">
          <span class="value value--small">{{ wash.headline }}</span>
          <span class="label">{{ wash.detail }}</span>
          {% if wash.out_at %}<span class="description">Out {{ wash.out_at }}{% if wash.dry_by %} · dry {{ wash.dry_by }}{% endif %} · in by {{ wash.in_by }}</span>{% endif %}
        </div>
      </div>
    </div>
    <div class="nc-chart" style="height: 80px;">
      {% for b in chart.bars %}
        <div class="nc-bar{% if b.win %} nc-bar--win{% endif %}{% if b.wet %} nc-bar--wet{% endif %}{% if b.label == chart.now %} nc-bar--now{% endif %}">
          <div class="nc-bar-track"><div class="nc-bar-fill" style="height: {{ b.pct }}%;"></div></div>
          <span class="nc-bar-hour label label--small">{{ b.label }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
</div>

<div class="title_bar">
  <span class="title">MMLAAA</span>
  <span class="instance">{{ now.time }}</span>
</div>
