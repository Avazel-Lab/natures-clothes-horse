<div class="layout">
{% if error %}
  <span class="title">Couldn't get the forecast: {{ error }}</span>
{% else %}
  <div class="nc">
    <div class="nc-row nc-row--stretch nc-grow">
      <div class="nc-row nc-now--third">
        <span class="nc-icon nc-wi nc-now-icon">{{ now.icon }}</span>
        <div class="nc-col">
          <span class="value value--large">{{ now.temp }}°</span>
          <span class="label">{{ now.text }}</span>
          <span class="description">Feels {{ now.feels }}° · {{ now.humidity }}% · {{ now.wind }} mph</span>
          <span class="description">High {{ today.hi }}° · tonight {{ today.lo }}° · tomorrow {{ tomorrow.hi }}°</span>
        </div>
      </div>
      <div class="nc-wash nc-wash--{{ wash.code }} nc-row">
        <span class="nc-icon nc-wi nc-wash-icon nc-wash-icon--small">{{ wash.icon }}</span>
        <div class="nc-col nc-grow">
          <span class="value value--small">{{ wash.headline }}</span>
          <span class="label">{{ wash.detail }}</span>
          <span class="description">{% render "wash_times", wash: wash %}</span>
        </div>
      </div>
    </div>
    {% render "chart", chart: chart, small: true %}
  </div>
{% endif %}
</div>

<div class="title_bar">
  <span class="title">MoMRAAA</span>
  <span class="instance">{{ now.time }}</span>
</div>
