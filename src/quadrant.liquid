<div class="layout">
{% if error %}
  <span class="title">Couldn't get the forecast: {{ error }}</span>
{% else %}
  <div class="nc">
    <div class="nc-row">
      <i class="wi {{ now.icon }} nc-wi" style="font-size: 32px; width: 40px;"></i>
      <span class="value value--small">{{ now.temp }}°</span>
      <span class="description nc-grow">{{ now.text }}<br>{{ today.hi }}°/{{ today.lo }}° · tmrw {{ tomorrow.hi }}°/{{ tomorrow.lo }}°</span>
    </div>
    <div class="nc-wash nc-wash--{{ wash.code }} nc-col" style="justify-content: center; padding: 8px 12px;">
      <span class="value value--small">{{ wash.headline }}</span>
      <span class="label">{{ wash.detail }}</span>
      {% if wash.out_at %}<span class="description">Out {{ wash.out_at }}{% if wash.dry_by %} · dry {{ wash.dry_by }}{% endif %} · in {{ wash.in_by }}</span>{% endif %}
    </div>
  </div>
{% endif %}
</div>

<div class="title_bar">
  <span class="title">MMLAAA</span>
  <span class="instance">{{ now.time }}</span>
</div>
