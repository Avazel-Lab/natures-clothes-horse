<div class="layout">
{% if error %}
  <span class="title">Couldn't get the forecast: {{ error }}</span>
{% else %}
  <div class="nc">
    <div class="nc-row">
      <span class="nc-icon nc-wi nc-now-icon--small">{{ now.icon }}</span>
      <span class="value value--small">{{ now.temp }}°</span>
      <span class="description nc-grow">{{ now.text }}<br>High {{ today.hi }}° · tonight {{ today.lo }}°</span>
    </div>
    <div class="nc-wash nc-wash--compact nc-wash--{{ wash.code }} nc-col nc-col--center">
      <span class="value value--small">{{ wash.headline }}</span>
      <span class="label">{{ wash.detail }}</span>
      <span class="description">{% render "wash_times", wash: wash %}</span>
    </div>
  </div>
{% endif %}
</div>

<div class="title_bar">
  <span class="title">MoMRAAA</span>
  <span class="instance">{{ now.time }}</span>
</div>
