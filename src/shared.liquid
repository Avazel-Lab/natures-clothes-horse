<style>
  .nc { display: flex; flex-direction: column; gap: 10px; width: 100%; height: 100%; }
  .nc--center { justify-content: center; align-items: center; }
  .nc-row { display: flex; align-items: center; gap: 10px; }
  .nc-row--stretch { align-items: stretch; }
  .nc-row--spread { justify-content: space-between; }
  .nc-row--tight { gap: 8px; }
  .nc-grow { flex: 1 1 0; min-width: 0; }
  .nc-now { flex: 1.6 1 0; min-width: 0; }
  .nc-now--third { flex: 0 0 36%; }
  .nc-col { display: flex; flex-direction: column; gap: 2px; }
  .nc-col--center { justify-content: center; }
  .nc-nowrap { white-space: nowrap; }
  .nc-wi { line-height: 1; text-align: center; }
  /* Icons are inline SVG sized by font-size, coloured like the text. */
  .nc-icon { display: inline-block; line-height: 1; vertical-align: middle; }
  /* The SVGs leave more margin than the old icon font did, hence 1.4em.
     crispEdges: anti-aliased grey edges get smeared by e-ink rendering. */
  .nc-icon svg { width: 1.4em; height: 1.4em; fill: currentColor; display: block; margin: 0 auto;
                 shape-rendering: crispEdges; }

  /* Current conditions + today/tomorrow */
  .nc-now-icon { font-size: 56px; width: 72px; }
  .nc-now-icon--small { font-size: 32px; width: 40px; }
  .nc-day { border-left: 2px solid #000; padding-left: 12px; }
  .nc-day-icon { font-size: 30px; width: 40px; }
  .nc-sun i { font-size: 14px; margin-right: 2px; }

  /* Washing verdict */
  .nc-wash { flex: 1 1 0; border: 3px solid #000; border-radius: 10px; padding: 10px 20px; gap: 6px; }
  .nc-wash--compact { padding: 8px 12px; gap: 10px; }
  .nc-wash--go { background: #000; }
  .nc-wash--go * { color: #fff !important; }
  .nc-wash-icon { font-size: 80px; line-height: 1; }
  .nc-wash-icon--small { font-size: 44px; }
  .nc-row--wide { gap: 20px; }
  /* Today / Tomorrow table: day, out, light, normal, heavy, in by */
  .nc-plan { display: grid; grid-template-columns: auto repeat(5, 1fr); column-gap: 16px; row-gap: 4px;
             align-items: baseline; text-align: center; border-top: 2px solid #000; padding-top: 8px; margin-top: 8px; }
  .nc-wash--go .nc-plan { border-color: #fff; }
  .nc-plan > * { justify-self: center; }
  .nc-plan > .nc-plan-day { justify-self: start; }
  .nc-plan-note { grid-column: 2 / 6; }

  /* Drying timeline. Each bar sets --pct inline, from the data. */
  .nc-chart { height: 150px; display: flex; gap: 2px; }
  .nc-chart--small { height: 90px; }
  .nc-bar { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .nc-bar-track { position: relative; width: 100%; flex: 1 1 0; min-height: 0; border-bottom: 2px solid #000; }
  .nc-bar-fill { max-height: 100%; }
  .nc-bar-fill { position: absolute; bottom: 0; left: 8%; width: 84%; height: var(--pct); background: #aaa; }
  .nc-bar--hang .nc-bar-fill { background: #000; }
  .nc-bar--risky .nc-bar-fill { background: repeating-linear-gradient(45deg, #000 0 5px, #aaa 5px 10px); }
  .nc-bar--wet .nc-bar-fill { background: repeating-linear-gradient(45deg, #000 0 3px, #fff 3px 9px); border: 2px solid #000; min-height: 18px; }
  /* Digits centred on the bar; the unit hangs off to the right. */
  .nc-bar-prob { position: absolute; left: 0; right: 0; bottom: max(var(--pct), 18px); display: flex; justify-content: center; padding-bottom: 2px; white-space: nowrap; }
  .nc-num { position: relative; display: inline-block; }
  .nc-unit { position: absolute; left: 100%; top: 0; margin-left: 1px; }
  .nc-bar--now .nc-bar-hour { background: #000; color: #fff; border-radius: 4px; padding: 0 5px; }
  .nc-key { display: inline-block; width: 11px; height: 11px; vertical-align: middle; margin: 0 3px 0 10px; }
  .nc-key--hang { background: #000; }
  .nc-key--risky { background: repeating-linear-gradient(45deg, #000 0 3px, #aaa 3px 6px); }
  .nc-key--dry { background: #aaa; }
  /* Night: a solid black band over the night hours, labelled in the middle. */
  .nc-band { display: flex; gap: 2px; height: 16px; margin-bottom: 2px; }
  .nc-band--small { height: 6px; }
  .nc-band-cell { flex: 1 1 0; display: flex; align-items: center; justify-content: center; overflow: visible;
                  white-space: nowrap; line-height: 1; }
  .nc-band-cell--night { background: #000; color: #fff; margin: 0 -1px; }
  .nc-band-text { color: #fff !important; }
  .nc-key--wet { background: repeating-linear-gradient(45deg, #000 0 2px, #fff 2px 5px); border: 1px solid #000; }
</style>

{% comment %} Next 24 hours: drying bars, rain chance, night shading.
   Params: chart, small (labels every 3 hours, no rain %). {% endcomment %}
{% template chart %}
<div class="nc-band{% if small %} nc-band--small{% endif %}">
  {% for b in chart.bars %}
    <div class="nc-band-cell{% if b.night %} nc-band-cell--night{% endif %}">{% if b.night_label %}{% unless small %}<span class="label label--small nc-band-text">night</span>{% endunless %}{% endif %}</div>
  {% endfor %}
</div>
<div class="nc-chart{% if small %} nc-chart--small{% endif %}">
  {% for b in chart.bars %}
    <div class="nc-bar{% if b.hang == "yes" %} nc-bar--hang{% elsif b.hang == "risky" %} nc-bar--risky{% endif %}{% if b.wet %} nc-bar--wet{% endif %}{% if b.night %} nc-bar--night{% endif %}{% if b.now %} nc-bar--now{% endif %}" style="--pct: {{ b.pct }}%">
      <div class="nc-bar-track">
        {% unless small %}{% if b.prob >= 20 %}<span class="nc-bar-prob"><span class="label label--small nc-num">{{ b.prob }}<span class="nc-unit">%</span></span></span>{% endif %}{% endunless %}
        <div class="nc-bar-fill"></div>
      </div>
      <span class="nc-bar-hour label label--small">{% if b.tick %}{{ b.label }}{% elsif small %}&nbsp;{% else %}{{ b.label }}{% endif %}</span>
    </div>
  {% endfor %}
</div>
{% endtemplate %}

{% comment %} One-line summary of the washing times. Param: wash. {% endcomment %}
{% template wash_times %}
{% if wash.out_at %}Out {% if wash.when == "tomorrow" %}tomorrow {% endif %}{{ wash.out_at }}{% if wash.dry_by %} · dry {{ wash.dry_by }}{% endif %} · in by {{ wash.in_by }}{% endif %}
{% endtemplate %}

