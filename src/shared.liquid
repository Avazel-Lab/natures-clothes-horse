<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/weather-icons/2.0.12/css/weather-icons.min.css">
<style>
  .nc { display: flex; flex-direction: column; gap: 10px; width: 100%; height: 100%; }
  .nc--center { justify-content: center; align-items: center; }
  .nc-row { display: flex; align-items: center; gap: 10px; }
  .nc-row--stretch { align-items: stretch; }
  .nc-row--spread { justify-content: space-between; }
  .nc-row--tight { gap: 8px; }
  .nc-grow { flex: 1 1 0; min-width: 0; }
  .nc-now { flex: 1.6 1 0; min-width: 0; }
  .nc-now--third { flex: 0 0 36%; }
  .nc-col { display: flex; flex-direction: column; gap: 2px; }
  .nc-col--center { justify-content: center; }
  .nc-nowrap { white-space: nowrap; }
  .nc-wi { line-height: 1; text-align: center; }

  /* Current conditions + today/tomorrow */
  .nc-now-icon { font-size: 56px; width: 72px; }
  .nc-now-icon--small { font-size: 32px; width: 40px; }
  .nc-day { border-left: 2px solid #000; padding-left: 12px; }
  .nc-day-icon { font-size: 30px; width: 40px; }
  .nc-sun i { font-size: 14px; margin-right: 2px; }

  /* Washing verdict */
  .nc-wash { flex: 1 1 0; border: 3px solid #000; border-radius: 10px; padding: 10px 20px; gap: 6px; }
  .nc-wash--compact { padding: 8px 12px; gap: 10px; }
  .nc-wash--go { background: #000; }
  .nc-wash--go * { color: #fff !important; }
  .nc-wash-icon { font-size: 80px; line-height: 1; }
  .nc-wash-icon--small { font-size: 44px; }
  .nc-row--wide { gap: 20px; }
  .nc-stats { justify-content: space-around; border-top: 2px solid #000; padding-top: 10px; margin-top: 10px; }
  .nc-wash--go .nc-stats, .nc-wash--go .nc-stats-rule { border-color: #fff; }
  .nc-stats-rule { align-self: stretch; border-left: 2px solid #000; }
  .nc-stat { text-align: center; min-width: 96px; align-items: center; }

  /* Drying timeline. Each bar sets --pct inline, from the data. */
  .nc-chart { height: 190px; display: flex; gap: 4px; }
  .nc-chart--small { height: 90px; }
  .nc-bar { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .nc-bar-track { position: relative; width: 100%; flex: 1 1 0; border-bottom: 2px solid #000; }
  .nc-bar-fill { position: absolute; bottom: 0; left: 10%; width: 80%; height: var(--pct); background: #aaa; }
  .nc-bar--win .nc-bar-fill { background: #000; }
  .nc-bar--wet .nc-bar-fill { background: repeating-linear-gradient(45deg, #000 0 3px, #fff 3px 9px); border: 2px solid #000; min-height: 18px; }
  .nc-bar-prob { position: absolute; left: 0; right: 0; bottom: max(var(--pct), 18px); text-align: center; padding-bottom: 2px; }
  .nc-bar--past .nc-bar-fill { background: #ddd; }
  .nc-bar--past.nc-bar--wet .nc-bar-fill { background: repeating-linear-gradient(45deg, #999 0 3px, #fff 3px 9px); border-color: #999; }
  .nc-bar--past .nc-bar-prob { display: none; }
  .nc-bar--now .nc-bar-hour { background: #000; color: #fff; border-radius: 4px; padding: 0 5px; }
  .nc-key { display: inline-block; width: 11px; height: 11px; vertical-align: middle; margin: 0 3px 0 10px; }
  .nc-key--win { background: #000; }
  .nc-key--dry { background: #aaa; }
  .nc-key--wet { background: repeating-linear-gradient(45deg, #000 0 2px, #fff 2px 5px); border: 1px solid #000; }
</style>

{% comment %} Hourly drying bars. Params: chart, small (hides rain %). {% endcomment %}
{% template chart %}
<div class="nc-chart{% if small %} nc-chart--small{% endif %}">
  {% for b in chart.bars %}
    <div class="nc-bar{% if b.win %} nc-bar--win{% endif %}{% if b.wet %} nc-bar--wet{% endif %}{% if b.past %} nc-bar--past{% endif %}{% if b.label == chart.now %} nc-bar--now{% endif %}" style="--pct: {{ b.pct }}%">
      <div class="nc-bar-track">
        {% unless small %}{% if b.prob >= 20 %}<span class="nc-bar-prob label label--small">{{ b.prob }}%</span>{% endif %}{% endunless %}
        <div class="nc-bar-fill"></div>
      </div>
      <span class="nc-bar-hour label{% if small %} label--small{% endif %}">{{ b.label }}</span>
    </div>
  {% endfor %}
</div>
{% endtemplate %}

{% comment %} One-line summary of the washing times. Param: wash. {% endcomment %}
{% template wash_times %}
{% if wash.out_at %}Out {% if wash.when == "tomorrow" %}tomorrow {% endif %}{{ wash.out_at }}{% if wash.dry_by %} · dry {{ wash.dry_by }}{% endif %} · in by {{ wash.in_by }}{% endif %}
{% endtemplate %}
