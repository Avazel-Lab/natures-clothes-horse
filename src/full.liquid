<div class="layout">
{% if error %}
  <div class="nc nc--center">
    <span class="title">Couldn't get the forecast</span>
    <span class="description">{{ error }}</span>
  </div>
{% else %}
  <div class="nc">

    <!-- Now | Today | Tomorrow -->
    <div class="nc-row">
      <div class="nc-row nc-now">
        <i class="wi {{ now.icon }} nc-wi nc-now-icon"></i>
        <div class="nc-col">
          <span class="value value--xlarge">{{ now.temp }}°</span>
          <span class="title">{{ now.text }}</span>
          <span class="label">Feels {{ now.feels }}° · {{ now.humidity }}% humidity</span>
          <span class="label">Wind {{ now.wind_dir }} {{ now.wind }} mph, gusts {{ now.gust }}</span>
        </div>
      </div>
      {% for d in (1..2) %}
        {% if forloop.first %}{% assign day = today %}{% else %}{% assign day = tomorrow %}{% endif %}
        {% if day %}
        <div class="nc-day nc-grow nc-col">
          <span class="label label--underline">{{ day.name }}</span>
          <div class="nc-row nc-row--tight">
            <i class="wi {{ day.icon }} nc-wi nc-day-icon"></i>
            <span class="value value--xsmall">{{ day.hi }}° / {{ day.lo }}°</span>
          </div>
          <span class="description">{{ day.text }}</span>
          <span class="description">Rain {{ day.rain }}%</span>
          <span class="description nc-sun"><i class="wi wi-sunrise"></i>{{ day.sunrise }} &nbsp;<i class="wi wi-sunset"></i>{{ day.sunset }}</span>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Washing verdict -->
    <div class="nc-wash nc-wash--{{ wash.code }} nc-row">
      <i class="wi {{ wash.icon }} nc-wash-icon"></i>
      <div class="nc-col nc-grow">
        <span class="value value--xlarge nc-nowrap">{{ wash.headline }}</span>
        <span class="title title--large">{{ wash.detail }}</span>
        {% if wash.why %}<span class="label">{{ wash.why | capitalize }}</span>{% endif %}
      </div>
      {% if wash.out_at %}
        <div class="nc-col nc-stat">
          <span class="label">Out{% if wash.when == "tomorrow" %} tomorrow{% endif %}</span>
          <span class="value value--small">{{ wash.out_at }}</span>
        </div>
        <div class="nc-col nc-stat">
          <span class="label">Dry by</span>
          <span class="value value--small">{% if wash.dry_by %}{{ wash.dry_by }}{% else %}–{% endif %}</span>
        </div>
        <div class="nc-col nc-stat">
          <span class="label">In by</span>
          <span class="value value--small">{{ wash.in_by }}</span>
          <span class="description">{% if wash.in_why == "rain" %}rain{% else %}sunset{% endif %}</span>
        </div>
      {% endif %}
    </div>

    <!-- Drying timeline -->
    <div class="nc-col">
      <div class="nc-row nc-row--spread">
        <span class="label">{{ chart.day }}: drying strength by hour</span>
        <span class="description">
          <span class="nc-key nc-key--win"></span>washing out
          <span class="nc-key nc-key--dry"></span>dry
          <span class="nc-key nc-key--wet"></span>rain likely
        </span>
      </div>
      {% render "chart", chart: chart %}
    </div>

  </div>
{% endif %}
</div>

<div class="title_bar">
  <span class="title">Ministry of Meteorology, Laundry &amp; Associated Atmospheric Affairs</span>
  <span class="instance">{% if now %}Updated {{ now.time }} · {{ load | capitalize }} load{% endif %}</span>
</div>
